# Mark binary asset extensions explicitly so Git never tries to normalize
# their line endings. The Inter_24pt-*.ttf files were silently corrupted
# by a CRLF round-trip on a Windows checkout once already; this prevents
# that class of mistake from recurring on any future binary.

# Generated dependency lockfile. Committed for INTEGRITY, not for diffing: without it CI
# re-resolves the whole transitive tree from the network on every run and executes install
# scripts, and a lockfile is what pins exact tarballs with integrity hashes. Marked generated
# so 85 KB of churn collapses in review instead of burying the change it travels with.
package-lock.json linguist-generated=true

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.tiff binary

# Documents and archives
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary

# Audio / video (in case any get added)
*.mp3 binary
*.mp4 binary
*.webm binary
*.mov binary
*.wav binary

# Database dumps and other opaque blobs
*.db binary
*.sqlite binary
*.sqlite3 binary
